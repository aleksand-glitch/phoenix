get_config = safr_pda_mcm.get_config -- mcm file was renamed to apply new load order

local SINGLETON = nil
function ui_pda_relations_tab.get_ui()
--	SINGLETON = SINGLETON or pda_relations_tab()
	game_relations_analytics.create_snapshot() -- making sure snapshot is created when PDA is (first) used at the latest and definitely after relations have been set up.
	SINGLETON = ui_pda_relations_tab.pda_relations_tab()
	SINGLETON:Reset()
	return SINGLETON
end

