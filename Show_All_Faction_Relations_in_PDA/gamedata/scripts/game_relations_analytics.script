local function save_state(m_data)
	if (USE_MARSHAL) then
		create_snapshot()
		
		printdbg("# SAVING: Faction Relations Analytics Persistent Data")
		
		if relations_analytics_config then
			printdbg("- TABLE: relations_analytics_config")
			print_table(relations_analytics_config)
			--m_data.relations_analytics_config = dup_table(relations_analytics_config)
			m_data.relations_analytics_config = relations_analytics_config
		else
			printdbg("! TABLE: relations_analytics_config is nil")
		end
		
		if relations_default then
			printdbg("- TABLE: relations_default")
			--print_table(relations_default)
			--m_data.relations_default = dup_table(relations_default)
			m_data.relations_default = relations_default
		else
			printdbg("! TABLE: relations_default is nil")
		end
		
		if relations_history then
			printdbg("- TABLE: relations_history")
			--print_table(relations_history)
			--m_data.relations_history = dup_table(relations_history)
			m_data.relations_history = relations_history
		else
			printdbg("! TABLE: relations_history is nil")
		end
		
		if kill_count then
			printdbg("- TABLE: kill_count")
			--print_table(kill_count)
			--m_data.kill_count = dup_table(kill_count)
			m_data.kill_count = kill_count
		else
			printdbg("! TABLE: kill_count is nil")
		end

		if kill_count_history then
			printdbg("- TABLE: kill_count_history")
			--print_table(kill_count_history)
			--m_data.kill_count_history = dup_table(kill_count_history)
			m_data.kill_count_history = kill_count_history
		else
			printdbg("! TABLE: kill_count_history is nil")
		end
	end
end

local function load_state(m_data)
	if (USE_MARSHAL) then
		printdbg("# LOADING: Faction Relations Analytics Persistent Data")
		
		relations_analytics_config = m_data.relations_analytics_config or nil
		if relations_analytics_config then
			printdbg("- TABLE: relations_analytics_config")
			print_table(relations_analytics_config)
		else
			printdbg("! TABLE: relations_analytics_config is nil")
		end
		
		relations_default = m_data.relations_default or nil
		if relations_default then
			printdbg("- TABLE: relations_default")
			--print_table(relations_default)
		else
			printdbg("! TABLE: relations_default is nil")
		end
		
		relations_history = m_data.relations_history or nil
		if relations_history then
			printdbg("- TABLE: relations_history")
			--print_table(relations_history)
		else
			printdbg("! TABLE: relations_history is nil")
		end
		
		kill_count = m_data.kill_count or nil
		if kill_count then
			printdbg("- TABLE: kill_count")
			--print_table(kill_count)
		else
			printdbg("! TABLE: kill_count is nil")
		end
		
		kill_count_history = m_data.kill_count_history or nil
		if kill_count_history then
			printdbg("- TABLE: kill_count_history")
			--print_table(kill_count_history)
		else
			printdbg("! TABLE: kill_count_history is nil")
		end
		--create_snapshot() -- crashes the game
	end
end

