-- pda_phoenix.script
-- Интеграция фракции "Phoenix" в интерфейс ПДА

function on_game_start()
    RegisterScriptCallback("on_game_load", init_phoenix_integration)
end

function init_phoenix_integration()
    if not ui_pda_relations_tab then
        return
    end

    local function add_to_list_safe(list, value)
        if not list then return end
        for _, v in ipairs(list) do
            if v == value then return end
        end
        table.insert(list, value)
    end

    -- Регистрация фракции для таблицы отношений и справки
    add_to_list_safe(ui_pda_relations_tab.faction_code_list, "phoenix")
    add_to_list_safe(ui_pda_relations_tab.enc_ref_list, "phoenix")
end