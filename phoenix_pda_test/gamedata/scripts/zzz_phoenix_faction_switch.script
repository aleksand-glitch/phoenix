--[[
	zzz_phoenix_faction_switch.script

	Reacts to the "Become Phoenix" MCM checkbox (zzz_phoenix_mcm.script) and
	switches the actor's own faction on the fly via db.actor:set_character_community().

	NOTE: set_character_community is a modded-exes function. If you're not running
	a modded exe build (e.g. xray-monolith), this will fail — the pcall below
	catches that so it won't crash the game, it'll just show an on-screen error.
]]

local function on_option_change()
	if not db.actor then return end
	if not ui_mcm then return end

	local want_phoenix = ui_mcm.get("phoenix_faction/become_phoenix")
	if want_phoenix == nil then return end

	local current = db.actor:character_community()

	if want_phoenix and current ~= "phoenix" then
		local ok = pcall(function() db.actor:set_character_community("phoenix") end)
		if ok then
			actor_menu.set_msg(1, game.translate_string("ui_mcm_phoenix_become"), 4)
		else
			actor_menu.set_msg(1, game.translate_string("ui_mcm_phoenix_cannot_switch"), 5)
		end
	elseif not want_phoenix and current == "phoenix" then
		-- Player unticked the box while already Phoenix -- revert to loner as a safe default.
		local ok = pcall(function() db.actor:set_character_community("stalker") end)
		if ok then
			actor_menu.set_msg(1, game.translate_string("ui_mcm_phoenix_reverted"), 4)
		end
	end
end

function on_game_start()
	RegisterScriptCallback("on_option_change", on_option_change)
end

function on_game_end()
	UnregisterScriptCallback("on_option_change", on_option_change)
end
