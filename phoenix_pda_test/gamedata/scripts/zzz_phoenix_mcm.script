-- zzz_phoenix_mcm.script
-- MCM registration: adds a "Become Phoenix" checkbox under ESC menu -> Mod Configuration Menu.

function on_mcm_load()
	return {
		id = "phoenix_faction",
		sh = true,
		gr = {
			{ id = "title", type = "title", text = "ui_mcm_phoenix_title" },
			{ id = "desc", type = "desc", text = "ui_mcm_phoenix_desc" },
			{ id = "become_phoenix", type = "check", val = 1, def = false, text = "ui_mcm_phoenix_become" },
		}
	}
end
