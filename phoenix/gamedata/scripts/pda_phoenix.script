-- pda_phoenix.script
-- Безопасная интеграция группировки «Феникс» в интерфейс ПДА

function on_game_start()
    RegisterScriptCallback("on_game_load", init_phoenix)
end

function init_phoenix()
    -- Безопасно добавляем фракцию в таблицы мода ПДА (Show All Faction Relations)
    if ui_pda_relations_tab then
        local function add_safe(tbl, val)
            if not tbl then return end
            for _, v in ipairs(tbl) do
                if v == val then return end
            end
            table.insert(tbl, val)
        end

        if ui_pda_relations_tab.enc_ref_list then
            add_safe(ui_pda_relations_tab.enc_ref_list, "phoenix")
        end
        if ui_pda_relations_tab.faction_code_list then
            add_safe(ui_pda_relations_tab.faction_code_list, "phoenix")
        end
        
        printf("~ [Phoenix Patch] Группировка 'phoenix' успешно добавлена в интерфейс ПДА!")
    end
end